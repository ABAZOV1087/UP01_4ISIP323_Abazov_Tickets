<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#193D57"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="#193D57"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
    </Style>

    <Style TargetType="Frame">
        <Setter Property="Background" Value="#193D57"/>
    </Style>

    <Style TargetType="Page">
        <Setter Property="Background" Value="#193D57"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
    </Style>

    <Style TargetType="Grid" x:Key="HeaderFooterGrid">
        <Setter Property="Background" Value="#0F2637"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="165"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="#256569"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4dc6c5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#256569"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4dc6c5"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#256569"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4dc6c5"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#eaebed"/>
        <Setter Property="Foreground" Value="#193D57"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="#193D57"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4dc6c5"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#193D57"/>
        <Setter Property="RowBackground" Value="#193D57"/>
        <Setter Property="AlternatingRowBackground" Value="#256569"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4dc6c5"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#4dc6c5"/>
        <Setter Property="VerticalGridLinesBrush" Value="#4dc6c5"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#0F2637"/>
        <Setter Property="Foreground" Value="#4dc6c5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="BorderBrush" Value="#4dc6c5"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#4dc6c5"/>
                <Setter Property="Foreground" Value="#193D57"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
