<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
    </Style>

    <Style TargetType="Frame">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style TargetType="Page">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
    </Style>

    <Style TargetType="Grid" x:Key="HeaderFooterGrid">
        <Setter Property="Background" Value="#233E76"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="165"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="#0198AF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#233E76"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#233E76"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#233E76"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#F3F3F3"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <Setter Property="BorderBrush" Value="#0198AF"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#F3F3F3"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <Setter Property="BorderBrush" Value="#0198AF"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#233E76"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F3F3F3"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
    </Style>
</ResourceDictionary>
