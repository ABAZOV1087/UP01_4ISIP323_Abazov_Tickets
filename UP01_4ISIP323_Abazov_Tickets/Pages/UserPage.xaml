<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет пользователя">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <TextBlock Text="Поиск по ФИО:" Margin="5"/>
            <TextBox x:Name="fioFilterTextBox" Width="160" Margin="5" ToolTip="Введите часть ФИО для поиска" TextChanged="fioFilterTextBox_TextChanged"/>

            <TextBlock Text="Сортировка:" Margin="10,5,5,5"/>
            <ComboBox x:Name="sortComboBox" Width="150" SelectedIndex="0" Margin="5" ToolTip="Порядок сортировки по ФИО" SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <CheckBox x:Name="onlyAdminCheckBox" Content="Только администраторы" VerticalAlignment="Center" Margin="10,5"
                      ToolTip="Показать только администраторов сервиса" Checked="onlyAdminCheckBox_Checked" Unchecked="onlyAdminCheckBox_Unchecked"/>

            <Button x:Name="clearFiltersButton" Content="Очистить фильтр" Width="140" ToolTip="Сбросить все параметры поиска" Click="clearFiltersButton_Click"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1" HorizontalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#0198AF" BorderThickness="1" CornerRadius="6" Margin="10" Padding="10">
                        <Grid Width="200">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="180"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding FIO}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>
                            <Image Grid.Row="1" Width="160" Height="160" Stretch="UniformToFill" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="Photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/res/logo.jpg</ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>
                            <TextBlock Grid.Row="2" Text="{Binding Role}" TextAlignment="Center" FontSize="14" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>