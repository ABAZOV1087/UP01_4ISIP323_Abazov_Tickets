<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.CategoryTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категории мероприятий">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridCategory" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название категории мероприятия" Binding="{Binding Name}" Width="*"/>
                <DataGridTemplateColumn Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" Width="140" Height="28" ToolTip="Редактировать категорию" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" x:Name="ButtonAdd" Content="Добавить" HorizontalAlignment="Left" Margin="20,0,0,0" ToolTip="Добавить категорию" Click="ButtonAdd_Click"/>
        <Button Grid.Row="1" x:Name="ButtonDel" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,20,0" ToolTip="Удалить выбранные категории" Click="ButtonDel_Click"/>
    </Grid>
</Page>