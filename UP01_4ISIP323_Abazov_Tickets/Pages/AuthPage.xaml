<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация пользователей">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
        <StackPanel x:Name="AuthPanel" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="Вход в билетный сервис" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Label x:Name="labelLogin" Content="Логин:"/>
            <Grid>
                <TextBox x:Name="TextBoxLogin" ToolTip="Введите логин" TextChanged="TextBoxLogin_TextChanged"/>
                <TextBlock x:Name="txtHintLogin" Text="Введите логин" Foreground="Gray" Margin="8,0,0,0" IsHitTestVisible="True" MouseLeftButtonUp="txtHintLogin_MouseLeftButtonUp"/>
            </Grid>

            <Label x:Name="labelPass" Content="Пароль:" Margin="0,10,0,0"/>
            <Grid>
                <PasswordBox x:Name="PasswordBox" ToolTip="Введите пароль" PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock x:Name="txtHintPass" Text="Введите пароль" Foreground="Gray" Margin="8,0,0,0" IsHitTestVisible="True" MouseLeftButtonUp="txtHintPass_MouseLeftButtonUp"/>
            </Grid>

            <Button x:Name="ButtonEnter" Content="Вход" ToolTip="Войти в систему" Click="ButtonEnter_OnClick" Margin="0,15,0,5"/>
            <Button x:Name="ButtonReg" Content="Регистрация" ToolTip="Создать новый аккаунт" Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля" ToolTip="Изменить действующий пароль" Click="ButtonChangePassword_Click"/>
        </StackPanel>

        <StackPanel x:Name="CaptchaPanel" Visibility="Hidden" HorizontalAlignment="Center" Width="320">
            <Label x:Name="labelCaptcha" Content="Введите код с картинки (капча):" HorizontalAlignment="Center"/>
            <TextBox x:Name="captcha" Height="45" Width="200" Foreground="Red" FontStyle="Italic" FontWeight="Heavy"
                     FontSize="22" IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     CommandManager.PreviewExecuted="textBox_PreviewExecuted" ContextMenu="{x:Null}" ToolTip="Код проверки"/>
            <TextBox x:Name="captchaInput" Width="200" Margin="0,10,0,10" ToolTip="Введите символы капчи сюда"/>
            <Button x:Name="submitCaptcha" Content="Подтвердить" ToolTip="Подтвердить ввод капчи" Click="submitCaptcha_Click"/>
        </StackPanel>
    </Grid>
</Page>