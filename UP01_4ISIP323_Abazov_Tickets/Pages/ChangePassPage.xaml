<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
        <StackPanel Width="320">
            <Label Content="Логин:"/>
            <TextBox x:Name="TbLogin" ToolTip="Введите ваш логин"/>

            <Label Content="Старый пароль:"/>
            <PasswordBox x:Name="CurrentPasswordBox" ToolTip="Введите текущий пароль"/>

            <Label Content="Новый пароль:"/>
            <PasswordBox x:Name="NewPasswordBox" ToolTip="Введите новый пароль"/>

            <Label Content="Подтвердите новый пароль:"/>
            <PasswordBox x:Name="ConfirmPasswordBox" ToolTip="Повторите новый пароль"/>

            <Button Content="Сохранить пароль" Margin="0,15,0,0" ToolTip="Сохранить изменения пароля" Click="BtnSavePass_Click"/>
        </StackPanel>
    </Grid>
</Page>