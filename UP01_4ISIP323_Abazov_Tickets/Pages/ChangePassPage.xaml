<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля пользователя">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
        <StackPanel Width="320">
            <Label Content="Логин:"/>
            <Grid>
                <TextBox x:Name="TbLogin" ToolTip="Введите ваш логин" TextChanged="TbLogin_TextChanged"/>
                <TextBlock x:Name="HintLogin" Text="Введите логин" Foreground="Gray" Margin="8,0,0,0" MouseLeftButtonUp="HintLogin_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Старый пароль:" Margin="0,8,0,0"/>
            <Grid>
                <PasswordBox x:Name="CurrentPasswordBox" ToolTip="Введите текущий пароль" PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="HintOldPass" Text="Введите текущий пароль" Foreground="Gray" Margin="8,0,0,0" MouseLeftButtonUp="HintOldPass_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Новый пароль:" Margin="0,8,0,0"/>
            <Grid>
                <PasswordBox x:Name="NewPasswordBox" ToolTip="Минимум 6 символов, англ. буквы и цифра" PasswordChanged="NewPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="HintNewPass" Text="Введите новый пароль" Foreground="Gray" Margin="8,0,0,0" MouseLeftButtonUp="HintNewPass_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Подтвердите новый пароль:" Margin="0,8,0,0"/>
            <Grid>
                <PasswordBox x:Name="ConfirmPasswordBox" ToolTip="Повторите новый пароль" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="HintConfirmPass" Text="Повторите новый пароль" Foreground="Gray" Margin="8,0,0,0" MouseLeftButtonUp="HintConfirmPass_MouseLeftButtonUp"/>
            </Grid>

            <Button Content="Сохранить пароль" Margin="0,18,0,0" ToolTip="Сохранить изменения пароля" Click="BtnSavePass_Click"/>
        </StackPanel>
    </Grid>
</Page>