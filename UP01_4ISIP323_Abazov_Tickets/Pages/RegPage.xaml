<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация нового пользователя">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="550">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Введите логин:" VerticalAlignment="Center"/>
        <Grid Grid.Row="0" Grid.Column="1">
            <TextBox x:Name="txtbxLog" ToolTip="Введите логин" TextChanged="txtbxLog_TextChanged"/>
            <Label x:Name="lblLogHitn" Content="Введите логин" Foreground="Gray" MouseLeftButtonUp="lblLogHitn_MouseLeftButtonUp"/>
        </Grid>

        <Label Grid.Row="1" Grid.Column="0" Content="Введите пароль:" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="1">
            <PasswordBox x:Name="passBxFrst" ToolTip="Минимум 6 символов, англ. раскладка и цифра" PasswordChanged="passBxFrst_PasswordChanged"/>
            <Label x:Name="lblPassHitn" Content="Введите пароль" Foreground="Gray" MouseLeftButtonUp="lblPassHitn_MouseLeftButtonUp"/>
        </Grid>

        <Label Grid.Row="2" Grid.Column="0" Content="Подтвердите пароль:" VerticalAlignment="Center"/>
        <Grid Grid.Row="2" Grid.Column="1">
            <PasswordBox x:Name="passBxScnd" ToolTip="Повторите пароль" PasswordChanged="passBxScnd_PasswordChanged"/>
            <Label x:Name="lblPassSecHitn" Content="Повторите пароль" Foreground="Gray" MouseLeftButtonUp="lblPassSecHitn_MouseLeftButtonUp"/>
        </Grid>

        <Label Grid.Row="3" Grid.Column="0" Content="Выберите роль:" VerticalAlignment="Center"/>
        <ComboBox x:Name="comboBxRole" Grid.Row="3" Grid.Column="1" ToolTip="Выберите роль пользователя">
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

        <Label Grid.Row="4" Grid.Column="0" Content="Введите ФИО:" VerticalAlignment="Center"/>
        <Grid Grid.Row="4" Grid.Column="1">
            <TextBox x:Name="txtbxFIO" ToolTip="Введите полное ФИО" TextChanged="txtbxFIO_TextChanged" PreviewTextInput="txtbxFIO_PreviewTextInput"/>
            <Label x:Name="lblFioHitn" Content="Введите ФИО" Foreground="Gray" MouseLeftButtonUp="lblFioHitn_MouseLeftButtonUp"/>
        </Grid>

        <Button x:Name="regButton" Grid.Row="5" Grid.ColumnSpan="2" Content="Зарегистрироваться" Width="200" ToolTip="Завершить регистрацию" Click="regButton_Click"/>
    </Grid>
</Page>