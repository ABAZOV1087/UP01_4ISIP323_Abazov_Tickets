<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление и редактирование пользователя">
    <Grid Width="550" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин:" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="TBLogin" Text="{Binding Login}" Grid.Row="0" Grid.Column="1" ToolTip="Введите логин"/>

        <TextBlock Text="Пароль:" Grid.Row="1" Grid.Column="0"/>
        <TextBox x:Name="TBPass" Text="{Binding Password}" Grid.Row="1" Grid.Column="1" ToolTip="Введите пароль"/>

        <TextBlock Text="Роль:" Grid.Row="2" Grid.Column="0"/>
        <ComboBox x:Name="cmbRole" Text="{Binding Role}" Grid.Row="2" Grid.Column="1" ToolTip="Выберите роль">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="User"/>
        </ComboBox>

        <TextBlock Text="ФИО:" Grid.Row="3" Grid.Column="0"/>
        <TextBox x:Name="TBFio" Text="{Binding FIO}" Grid.Row="3" Grid.Column="1" ToolTip="Введите ФИО"/>

        <TextBlock Text="Фото (необязательно):" Grid.Row="4" Grid.Column="0"/>
        <TextBox x:Name="TBPhoto" Text="{Binding Photo}" Grid.Row="4" Grid.Column="1" ToolTip="Путь к фото"/>

        <Button x:Name="ButtonClean" Content="Очистить" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Left" ToolTip="Очистить поля" Click="ButtonClean_Click"/>
        <Button x:Name="ButtonSave" Content="Сохранить" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" ToolTip="Сохранить запись" Click="ButtonSave_Click"/>
    </Grid>
</Page>