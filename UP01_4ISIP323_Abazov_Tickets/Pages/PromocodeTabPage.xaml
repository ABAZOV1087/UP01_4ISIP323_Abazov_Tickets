<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.PromocodeTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Промокоды и скидки">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridPromo" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код промокода" Binding="{Binding Code}" Width="*"/>
                <DataGridTextColumn Header="Скидка (%)" Binding="{Binding DiscountPercent}" Width="150"/>
                <DataGridTextColumn Header="Действует до" Binding="{Binding ValidUntil, StringFormat=dd.MM.yyyy}" Width="160"/>
                <DataGridTemplateColumn Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Width="135" Height="28" ToolTip="Редактировать промокод" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Добавить" HorizontalAlignment="Left" Margin="20,0,0,0" ToolTip="Добавить промокод" Click="ButtonAdd_Click"/>
        <Button Grid.Row="1" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,20,0" ToolTip="Удалить промокод" Click="ButtonDel_Click"/>
    </Grid>
</Page>