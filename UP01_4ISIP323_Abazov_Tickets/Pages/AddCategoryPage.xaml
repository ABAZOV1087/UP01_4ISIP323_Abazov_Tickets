<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление и редактирование категории мероприятия">
    <Grid Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Название категории мероприятия:" Margin="0,0,0,8"/>
            <TextBox x:Name="TBCategoryName" Text="{Binding Name}" ToolTip="Введите название категории"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="ButtonClean" Content="Очистить" ToolTip="Очистить поле" Click="ButtonClean_Click"/>
                <Button x:Name="ButtonSaveCategory" Content="Сохранить" ToolTip="Сохранить категорию" Click="ButtonSaveCategory_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>