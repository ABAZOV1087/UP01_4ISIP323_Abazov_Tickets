<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.EventTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Афиша мероприятий">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridEvent" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название мероприятия" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="140"/>
                <DataGridTextColumn Header="Площадка" Binding="{Binding Venue.Name}" Width="150"/>
                <DataGridTextColumn Header="Организатор" Binding="{Binding Organizer.Name}" Width="150"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Возраст" Binding="{Binding AgeLimit}" Width="75"/>
                <DataGridTemplateColumn Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Width="135" Height="28" ToolTip="Редактировать мероприятие" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Добавить" HorizontalAlignment="Left" Margin="20,0,0,0" ToolTip="Добавить мероприятие" Click="ButtonAdd_Click"/>
        <Button Grid.Row="1" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,20,0" ToolTip="Удалить выбранные мероприятия" Click="ButtonDel_Click"/>
    </Grid>
</Page>