<Page x:Class="UP01_4ISIP323_Abazov_Tickets.Pages.VenueTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Площадки проведения мероприятий">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <TextBlock Text="Поиск площадки:" Margin="5"/>
            <TextBox x:Name="TbSearch" Width="200" Margin="5" ToolTip="Введите название или адрес площадки" TextChanged="TbSearch_TextChanged"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="DataGridVenue" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название площадки" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="Вместимость (чел.)" Binding="{Binding Capacity}" Width="150"/>
                <DataGridTemplateColumn Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Width="135" Height="28" ToolTip="Редактировать площадку" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Добавить" HorizontalAlignment="Left" Margin="20,0,0,0" ToolTip="Добавить новую площадку" Click="ButtonAdd_Click"/>
        <Button Grid.Row="2" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,20,0" ToolTip="Удалить выбранные площадки" Click="ButtonDel_Click"/>
    </Grid>
</Page>